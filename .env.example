# Provision a free Postgres instance (Neon: https://neon.tech, or Vercel Postgres)
# and paste its connection string here. Then run: pnpm db:migrate
#
# The app works fully without this — favorites/recent/history fall back to
# localStorage-only until DATABASE_URL is set.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Base URL used for canonical links, sitemap, robots.txt, and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Search engine ownership verification. Get these after adding the site as a
# property in Google Search Console / Bing Webmaster Tools — use the "HTML tag"
# verification method and paste just the `content` value (not the full tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
